# =========================================================
# Devopstrio GitHub Pages Environment Configuration
# =========================================================
# 
# Instructions:
# 1. Copy this file to '.env' in the root directory.
# 2. (Optional) Provide a GitHub Personal Access Token (PAT) 
#    to increase GitHub API rate limits from 60 to 5,000 req/hr.
# 
# How to generate a free GitHub Token:
# GitHub -> Settings -> Developer Settings -> Personal Access Tokens 
# -> Fine-grained tokens or Tokens (classic) -> Generate new token
# (No special scopes required for fetching public repos).
# =========================================================

GITHUB_ORG=Devopstrio
GITHUB_TOKEN=your_github_personal_access_token_here
